# Копируется в /opt/nhatrang/.env, права 600, владелец nhatrang. НЕ коммитить с реальными значениями.
APP_ENV=prod
BOT_TOKEN=               # от @BotFather
BOT_USERNAME=            # без @
WEBHOOK_SECRET=          # openssl rand -hex 24
PHOTO_SIGN_SECRET=       # openssl rand -hex 24
ADMIN_IDS=               # Telegram ID Некита, через запятую
DB_PATH=/opt/nhatrang/data/app.db
PHOTOS_DIR=/opt/nhatrang/data/photos
WEB_DIR=/opt/nhatrang/web          # сюда кладутся index.html и js/
SHARED_DIR=/opt/nhatrang/shared    # ds.css, tgx.js
WEBAPP_URL=https://YOUR_DOMAIN/
TILES_URL=               # провайдер тайлов, например https://.../{z}/{x}/{y}.png (условия проверить!)
